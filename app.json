{
  "expo": {
    "name": "himnarioINA-app",
    "slug": "himnarioINA-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "himnarioinaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anderson8.himnarioINAapp"
    },
    "web": {
      "favicon": "./assets/images/adaptive-icon.png",
      "name": "Himnario INA",
      "shortName": "Himnario",
      "display": "standalone",
      "startUrl": "/",
      "backgroundColor": "#ffffff",
      "themeColor": "#ffffff",
      "pwa": {
        "manifest": {
          "name": "Himnario INA",
          "short_name": "Himnario",
          "start_url": ".",
          "display": "standalone",
          "background_color": "#ffffff",
          "theme_color": "#ffffff",
          "description": "Himnario de la Iglesia Nueva Apostólica",
          "icons": [
            {
              "src": "./assets/images/icon.png",
              "sizes": "1024x1024",
              "type": "image/png"
            }
          ]
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/adaptive-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8651534c-c4e5-42f8-b072-afad0d70e4e5"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8651534c-c4e5-42f8-b072-afad0d70e4e5"
    }
  }
}
